    "patientName": "John Doe",
    "appointmentId": "appt-doc-id-789",
    "invoiceNumber": "INV-2024-0315-001",
    "type": "appointment-fee",
    "amount": {
      "total": 150.00,
      "insurance": 120.00,
      "patientResponsibility": 30.00,
      "paid": 30.00,
      "balance": 0.00,
      "currency": "USD"
    },
    "description": "Annual physical examination and consultation",
    "serviceDate": "2024-03-15T09:00:00Z",
